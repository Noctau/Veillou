# HTTPS (Let's Encrypt) автоматически, как только DNS домена смотрит на сервер.
# DOMAIN и ACME_EMAIL — из .env (docker-compose.prod.yml).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Файлы до 100 МБ (бэкенд проверяет точнее)
	request_body {
		max_size 110MB
	}

	# «Поделиться» до того, как service worker установился: принять файлы некому —
	# просто открываем быстрое добавление
	@share_without_sw {
		method POST
		path /share-target
	}
	redir @share_without_sw /add 303

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/www
		# Сборка с хэшами в именах — навсегда; всё остальное (index.html, sw.js, manifest) — перепроверять
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
