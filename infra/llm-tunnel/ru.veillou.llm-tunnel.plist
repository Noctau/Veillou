<?xml version="1.0" encoding="UTF-8"?>
<!--
  Обратный SSH-туннель: домашняя Ollama (localhost:11434) → сервер (172.30.0.1:11434).
  Сервер, пользователь и ключ — в ~/.ssh/config (Host veillou-llm), здесь править нечего.
  Установка (Docs/DEPLOY.md §6): cp в ~/Library/LaunchAgents/ и
  launchctl load ~/Library/LaunchAgents/ru.veillou.llm-tunnel.plist
  launchd перезапускает ssh, если связь оборвалась или сервер ещё не готов.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ru.veillou.llm-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-o</string>
    <string>ServerAliveInterval=30</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>-o</string>
    <string>StrictHostKeyChecking=accept-new</string>
    <string>-R</string>
    <string>172.30.0.1:11434:localhost:11434</string>
    <string>veillou-llm</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Не чаще раза в 30 с, если сервер недоступен -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardErrorPath</key>
  <string>/tmp/veillou-llm-tunnel.log</string>
</dict>
</plist>
