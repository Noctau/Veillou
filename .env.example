# Копируется в .env в корне репо. Читается бэкендом и docker compose.
ENV=dev
DEBUG=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=veillou
POSTGRES_PASSWORD=veillou
POSTGRES_DB=veillou

DEFAULT_TIMEZONE=Europe/Moscow
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Telegram-бот (make bot). Токен — у @BotFather, имя — без @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
