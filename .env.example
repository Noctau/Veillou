# Копируется в .env в корне репо. Читается бэкендом и docker compose.
ENV=dev
DEBUG=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=veillou
POSTGRES_PASSWORD=veillou
POSTGRES_DB=veillou

DEFAULT_TIMEZONE=Europe/Moscow
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Telegram-бот (make bot). Токен — у @BotFather, имя — без @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Подпись ссылок на файлы. В проде обязательно: openssl rand -hex 32
SECRET_KEY=
# Куда складываются файлы (по умолчанию data/files в корне репо)
# STORAGE_DIR=/srv/veillou/files

# Публичный адрес (https://…) — ссылки «Открыть» в Telegram. Пусто в dev.
APP_URL=

# Web Push. Сгенерировать: make vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Деплой (make deploy, make backup-pull …) — читается только скриптами infra/*.sh
# DEPLOY_HOST=user@1.2.3.4
# DEPLOY_DIR=/srv/veillou/app
# BACKUP_DIR=/srv/veillou/backups
# BACKUP_LOCAL_DIR=~/Backups/veillou

# ИИ (разбивка заданий, разбор текста, фото). ollama — локально на маке (`ollama serve`);
# openai — любой OpenAI-совместимый API: LLM_BASE_URL=https://…/v1 и LLM_API_KEY.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
# Текст: qwen3:8b (или qwen2.5:7b-instruct); фото: qwen2.5vl:7b
LLM_MODEL=qwen3:8b
LLM_VISION_MODEL=qwen2.5vl:7b
# Запасной провайдер (необязательно): openai + base url / ключ / модель, например Timeweb AI
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
