# Прод-.env: лежит на сервере в DEPLOY_DIR (рядом с docker-compose.prod.yml), в git не попадает.
# Заполнить копию на маке (cp .env.prod.example .env.prod — в git не попадает) и отправить:
#   scp .env.prod deploy@IP:/srv/veillou/app/.env

# Домен, который смотрит на сервер (A-запись). HTTPS Caddy получит сам.
DOMAIN=veillou.example.com
# Почта для Let's Encrypt (уведомления об истечении сертификата). Обязательна: без неё web не стартует
ACME_EMAIL=you@example.com

DEFAULT_TIMEZONE=Europe/Moscow
SESSION_TTL_DAYS=30

POSTGRES_USER=veillou
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=veillou

# openssl rand -hex 32 — без него api не стартует
SECRET_KEY=

# Telegram (@BotFather). Без токена контейнер bot будет перезапускаться с ошибкой.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Web Push: make vapid-keys (можно на маке) — те же ключи навсегда, иначе подписки слетят
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Бэкапы: каталог на сервере, сколько хранить, владелец (uid/gid пользователя, под которым
# `make backup-pull` заходит по ssh: `id -u`, `id -g`)
BACKUP_DIR=/srv/veillou/backups
BACKUP_KEEP=14
BACKUP_UID=1000
BACKUP_GID=1000

# ИИ (разбивка заданий, разбор текста, фото) — Docs/DEPLOY.md, раздел «ИИ».
# Основной: Ollama на домашнем компьютере через обратный SSH-туннель — он слушает
# на шлюзе docker-сети llm (docker-compose.prod.yml).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://172.30.0.1:11434
LLM_API_KEY=
LLM_MODEL=qwen3:8b
LLM_VISION_MODEL=qwen2.5vl:7b
# Запасной: когда дома всё выключено (или модель ответила не по схеме) — Timeweb AI.
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_BASE_URL=https://api.timeweb.ai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_VISION_MODEL=
